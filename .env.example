APP_ENV=debug

DEPLOYMENT_ENVIRONMENT=local
APPLICATION_API_ROOT_PATH=/agent

CONFIGURATION_DIR=./config

# where this agent's LangGraph checkpointer sqlite db lives
CHECKPOINT_DB_HOST=/absolute/path/to/sqlite
CHECKPOINT_DB_NAME=checkpoint

# Where the toolbox is reachable -- deployed independently, own pod/Service.
# Must use the exact same host (e.g. always 127.0.0.1, never a mix of that
# and localhost) as the toolbox's own TOOLBOX_URL: the toolbox validates the
# incoming Host header against it and rejects a mismatch with 421.
TOOLBOX_URL=http://127.0.0.1:8001/mcp

# optional -- default shown
# LLM_BASE_URL=http://nautilus:1234/v1
