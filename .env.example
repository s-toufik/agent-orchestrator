APP_ENV=debug
LOG_LEVEL=INFO
DEPLOYMENT_ENVIRONMENT=local
CONFIGURATION_DIR=./config

# --- engine --------------------------------------------------------------------------
# langgraph | anthropic_sdk
AGENT_ENGINE=langgraph
# lower it for anthropic_sdk: each live conversation runs one CLI subprocess
MAX_CONCURRENT_STREAMS=200

# --- models (OpenAI-compatible llama.cpp) ---------------------------------------------
LLM_BASE_URL=http://sirius:8090/v1

# --- tools -------------------------------------------------------------------------
TOOLBOX_URL=http://127.0.0.1:8001/mcp

# --- conversation storage ----------------------------------------------------------
# langgraph: MongoDB checkpointer, falls back to sqlite. anthropic_sdk: MongoDB only.
DB_SQLITE_CHECKPOINT_HOST=/absolute/path/to/sqlite
DB_SQLITE_CHECKPOINT_NAME=checkpoint
DB_MONGO_CHECKPOINT_HOST=localhost
DB_MONGO_CHECKPOINT_PORT=27017
DB_MONGO_CHECKPOINT_NAME=conversation
DB_MONGO_CHECKPOINT_USERNAME=
DB_MONGO_CHECKPOINT_PASSWORD=

# --- telemetry -----------------------------------------------------------------------
OTEL_HOST=
OTEL_PORT=4317

# --- anthropic_sdk engine only -----------------------------------------------------
# Working directory of the agent: the only place its built-in file tools reach, and the key
# its sessions are stored under (same path on every instance). Mount the toolbox's
# WORKING_DIRECTORY at the same path to share files. Unset: ./working_directory
WORKING_DIRECTORY=/data/working_directory
# Built-in file tools, enabled only after a plan is approved: Read, Write, Edit, Glob, Grep
# (Edit needs Read). Empty: none.
AGENT_SDK_TOOLS=Glob,Grep
# LiteLLM translates Anthropic /v1/messages to LLM_BASE_URL; started and stopped by the agent
LITELLM_ENABLED=true
# LITELLM_COMMAND=uvx --from litellm[proxy]==1.102.1 litellm
# LITELLM_HOST=127.0.0.1
# LITELLM_PORT=4000
# when LITELLM_ENABLED=false, the Anthropic-compatible endpoint to call directly
# ANTHROPIC_BASE_URL=http://sirius:8090
# ANTHROPIC_AUTH_TOKEN=none
