APP_ENV=debug
LOG_LEVEL=INFO
DEPLOYMENT_ENVIRONMENT=local
CONFIGURATION_DIR=./config

# --- streams -------------------------------------------------------------------------
MAX_CONCURRENT_STREAMS=200
AGENT_ANSWER_DELIVERY=stream

# --- models (OpenAI-compatible llama.cpp) ---------------------------------------------
LLM_BASE_URL=http://sirius:8090/v1
LLM_API_KEY=

# --- tools -------------------------------------------------------------------------
TOOLBOX_URL=http://127.0.0.1:8001/mcp

# --- conversation storage ----------------------------------------------------------
DB_SQLITE_CHECKPOINT_HOST=/absolute/path/to/sqlite
DB_SQLITE_CHECKPOINT_NAME=checkpoint
DB_MONGO_CHECKPOINT_HOST=localhost
DB_MONGO_CHECKPOINT_PORT=27017
DB_MONGO_CHECKPOINT_NAME=conversation
DB_MONGO_CHECKPOINT_USERNAME=
DB_MONGO_CHECKPOINT_PASSWORD=

# --- telemetry -----------------------------------------------------------------------
GRPC_VERBOSITY=ERROR
OTEL_HOST=
OTEL_PORT=4317
